#!/usr/bin/env bash
# Local read-only discovery. Trusted PATH/tools required. No sudo or network probes.
set -u -o pipefail
export LC_ALL=C SYSTEMD_COLORS=0 SYSTEMD_PAGER=cat
if [ "$#" -gt 0 ]; then
  if [ "$#" -eq 1 ] && [ "$1" = --help ]; then
    printf 'Usage: host-audit\nLocal best-effort discovery; not a health verdict. Redact report before sharing.\n'
    exit 0
  fi
  printf 'ERROR: no arguments accepted\n' >&2
  exit 2
fi
unknown=0
have() { command -v "$1" >/dev/null 2>&1; }
section() { printf '\n== %s ==\n' "$1"; }
line() { printf '%-26s %s\n' "$1:" "$2"; }
missing() { unknown=$((unknown + 1)); line "$1" 'unknown/unavailable; targeted follow-up required'; }
# Avoid unbounded daemons, slow mounts and pagers. Do not run if timeout is absent.
probe() {
  local label="$1"
  shift
  if ! have timeout || ! have head || ! have "$1"; then missing "$label"; return; fi
  line "$label" 'bounded output follows (at most 16 KiB / 60 lines)'
  if timeout --kill-after=1s 4s "$@" 2>/dev/null | head -c 16384 | head -n 60; then
    line "${label}_status" 'completed; empty output is not a health verdict'
  else
    # Pipefail also catches SIGPIPE on truncation; partial evidence stays unknown.
    missing "${label}_status"
  fi
}
section 'Identity and visibility'
line timestamp_utc "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
line kernel "$(uname -r)"
line scope 'current namespaces only; a container does not expose complete host state'
if [ -r /etc/os-release ]; then
  # Parse data only; never source os-release or evaluate its values.
  awk -F= '/^(ID|ID_LIKE|VERSION_ID|PRETTY_NAME)=/ {print substr($0,1,300)}' /etc/os-release
else missing os_release; fi
probe virtualization systemd-detect-virt
probe cgroup_view cat /proc/self/cgroup
if [ -r /sys/fs/cgroup/cgroup.controllers ]; then
  line cgroup_version 'v2 visible; root values may not describe the affected service'
else line cgroup_version 'v1/hidden/unsupported; discover actual workload controller'; fi

section 'Resources (one snapshot, not a trend)'
probe cpu_count nproc
probe load cat /proc/loadavg
probe memory free -m
for resource in cpu memory io; do
  probe "psi_$resource" cat "/proc/pressure/$resource"
done
probe filesystems_bytes df -l -h -P -x tmpfs -x devtmpfs
probe filesystems_inodes df -l -i -P -x tmpfs -x devtmpfs
line thresholds 'compare against owner policy and growth; no universal health threshold applied'

section 'Services and time'
if [ -r /proc/1/comm ] && [ "$(cat /proc/1/comm)" = systemd ]; then
  probe failed_units systemctl --failed --no-legend --no-pager --plain
  probe time_sync timedatectl show -p NTPSynchronized -p TimeUSec
else missing systemd_host_view; fi
if [ -f /var/run/reboot-required ]; then
  line reboot_marker 'present; plan release-specific restart/reboot assessment'
else line reboot_marker 'not present; not proof that no reboot is required'; fi
line oom_evidence 'not collected; use scoped event/time/permission checks, including memcg and oomd'
line package_state 'not collected; no package manager or repository request made'

section 'Network and security'
probe listeners ss -H -lntu
probe addresses ip -br address
probe routes_v4 ip -4 route show
probe routes_v6 ip -6 route show
probe resolver_link readlink /etc/resolv.conf
if have getenforce; then probe selinux getenforce; else missing selinux; fi
line firewall 'not inferred from installed binaries; inspect effective policy with its owner'
line ssh_policy 'not inferred; validate version, Match context and real login through approved access'
line backup_monitoring 'not inferred from process/timer presence; require end-to-end evidence'

section 'Summary'
line unavailable_checks "$unknown"
line overall 'discovery only; available observations do not prove health or safety to change'
line next 'identify affected service/cgroup and interval; follow the matching procedure before remediation'
