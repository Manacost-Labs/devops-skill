#!/usr/bin/env bash
# Read-only Debian/Ubuntu host audit. It does not invoke sudo or make network requests.
set -u -o pipefail

warn=0
have() { command -v "$1" >/dev/null 2>&1; }
section() { printf '\n== %s ==\n' "$1"; }
line() { printf '%-28s %s\n' "$1:" "$2"; }
mark_warn() { warn=1; printf 'WARN: %s\n' "$1"; }
read_file() { [ -r "$1" ] && tr '\n' ' ' < "$1" || printf 'unknown'; }

section 'Identity'
line 'timestamp_utc' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
line 'hostname' "$(hostname 2>/dev/null || printf unknown)"
if [ -r /etc/os-release ]; then
  . /etc/os-release
  line 'os' "${PRETTY_NAME:-${ID:-unknown}}"
  case "${ID:-}" in debian|ubuntu) line 'support' 'full v1 support' ;; *) mark_warn "Unsupported OS family '${ID:-unknown}': discovery only in v1" ;; esac
else
  mark_warn '/etc/os-release is unavailable'
fi
line 'kernel' "$(uname -r 2>/dev/null || printf unknown)"
line 'uptime' "$(uptime -p 2>/dev/null || printf unknown)"
line 'virtualization' "$(systemd-detect-virt 2>/dev/null || printf unknown)"

section 'Time and updates'
if have timedatectl; then line 'time_sync' "$(timedatectl show -p NTPSynchronized --value 2>/dev/null || printf unknown)"; fi
if [ -f /var/run/reboot-required ]; then mark_warn 'reboot-required marker is present'; else line 'reboot_required' 'no marker'; fi
if have apt; then line 'apt_updates' "$(apt-get -s upgrade 2>/dev/null | awk '/^[0-9]+ upgraded/ {print; found=1} END {if (!found) print "unknown"}')"; fi

section 'Resources'
line 'loadavg' "$(cut -d' ' -f1-3 /proc/loadavg 2>/dev/null || printf unknown)"
if have free; then free -h; fi
if have df; then
  printf '%-28s %s\n' 'filesystem' 'use% mount'
  while IFS='|' read -r mount use; do
    [ -z "$mount" ] && continue
    level=''
    if [ "$use" -ge 90 ]; then level=' CRITICAL'; warn=1; elif [ "$use" -ge 80 ]; then level=' WARN'; warn=1; fi
    printf '%-28s %3s%%%s\n' "$mount" "$use" "$level"
  done < <(df -P -x tmpfs -x devtmpfs 2>/dev/null | awk 'NR>1 && $5 ~ /^[0-9]+%$/ {gsub("%", "", $5); print $6 "|" $5}')
  while IFS='|' read -r mount use; do
    [ -z "$mount" ] && continue
    if [ "$use" -ge 90 ]; then mark_warn "inode pressure $mount: $use%"; elif [ "$use" -ge 80 ]; then mark_warn "inode warning $mount: $use%"; fi
  done < <(df -Pi -x tmpfs -x devtmpfs 2>/dev/null | awk 'NR>1 && $5 ~ /^[0-9]+%$/ {gsub("%", "", $5); print $6 "|" $5}')
fi
if have journalctl && journalctl -k -b 2>/dev/null | grep -qiE 'out of memory|oom-kill|killed process'; then mark_warn 'OOM event detected in current boot'; else line 'oom_current_boot' 'none detected or unavailable'; fi

section 'Services and logs'
if have systemctl; then
  failed="$(systemctl --failed --no-legend --no-pager 2>/dev/null || true)"
  if [ -n "$failed" ]; then printf '%s\n' "$failed"; mark_warn 'failed systemd units present'; else line 'failed_units' 'none'; fi
  restarting="$(systemctl list-units --type=service --state=activating --no-legend --no-pager 2>/dev/null || true)"
  [ -n "$restarting" ] && { printf '%s\n' "$restarting"; mark_warn 'services are activating'; }
fi

section 'Access and network'
if have sshd; then
  ssh_effective="$(sshd -T 2>/dev/null || true)"
  [ -n "$ssh_effective" ] && {
    printf '%s\n' "$ssh_effective" | awk '/^(permitrootlogin|passwordauthentication|pubkeyauthentication|port) / {print}'
    printf '%s\n' "$ssh_effective" | grep -q '^passwordauthentication yes$' && mark_warn 'SSH password authentication enabled'
    printf '%s\n' "$ssh_effective" | grep -q '^permitrootlogin yes$' && mark_warn 'SSH root login enabled'
  }
fi
if have ss; then
  line 'listening_ports' 'protocol/local-address/port (review with owner)'
  ss -H -lntu 2>/dev/null | awk '{print $1, $5}' | sed -E 's/\[::\]:(.*)/[::]:\1/; s/0\.0\.0\.0:(.*)/0.0.0.0:\1/' | sort -u
fi
if have ufw; then line 'ufw' "$(ufw status 2>/dev/null | head -n1 || printf unavailable)"; elif have nft; then line 'firewall' 'nft present; policy requires targeted review'; else line 'firewall' 'no UFW/nft command found'; fi
if have getent; then line 'dns_resolver' "$(getent hosts localhost 2>/dev/null | head -n1 || printf unknown)"; fi

section 'Backup and monitoring evidence'
if have systemctl; then
  systemctl list-timers --all --no-pager 2>/dev/null | grep -Ei 'backup|snapshot|restic|borg|prometheus|node-exporter|otel|vector|fluent' || line 'agents_or_timers' 'not detected (not proof of absence)'
fi

section 'Summary'
if [ "$warn" -eq 1 ]; then
  printf 'overall: review required; this audit made no changes\n'
else
  printf 'overall: no immediate warning detected; this does not prove host health\n'
fi
printf 'next: create a change card before remediating findings; route cross-layer issues to the owning module\n'
