{
  "version": "2.0",
  "policy_id": "default-baseline",
  "risk_classes": ["R0", "R1", "R2", "R3", "R4"],
  "approval_ttl_minutes": 120,
  "minimum_approvals": {"R0": 0, "R1": 0, "R2": 1, "R3": 1, "R4": 1},
  "require_separation_of_duties": {"R0": false, "R1": false, "R2": false, "R3": false, "R4": true},
  "require_change_lock": ["R4"],
  "require_plan_digest": ["R2", "R3", "R4"],
  "always_require_approval": ["dns_change", "tls_change", "firewall_change", "iam_change", "secret_reference_change", "production_deploy", "production_state_change"],
  "require_recovery_evidence": ["database_migration", "persistent_volume_deletion", "object_deletion", "terraform_state_surgery", "production_failover"],
  "deny_by_default": ["literal_secrets", "mutable_production_images", "curl_pipe_bash", "unverified_dependency", "broad_admin_access", "untrusted_content_authority", "approval_reuse", "unbounded_tool_execution"],
  "completion_statuses": ["verified", "partially_verified", "rolled_back", "blocked"],
  "exceptions": {
    "allowed": true,
    "max_ttl_minutes": 120,
    "minimum_compensating_controls": 1,
    "never_waive": ["target_identity", "literal_secrets", "evidence_preservation", "post_change_verification"]
  },
  "ledger": {"hash_chain": true, "external_immutable_sink_required": false},
  "data": {"allowed_classifications": ["public", "internal", "confidential", "restricted"], "default": "restricted"}
}
