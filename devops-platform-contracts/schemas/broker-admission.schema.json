{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Signed exact broker admission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "audience",
    "registry_digest",
    "not_before",
    "expires",
    "grant_digest",
    "call_digest",
    "signatures"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "admission"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{5,79}$"
    },
    "audience": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{5,79}$"
    },
    "registry_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "not_before": {
      "type": "string",
      "format": "date-time"
    },
    "expires": {
      "type": "string",
      "format": "date-time"
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key_id",
          "signature"
        ],
        "properties": {
          "key_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{5,79}$"
          },
          "signature": {
            "type": "string",
            "minLength": 88,
            "maxLength": 88
          }
        }
      }
    },
    "grant_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "call_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
