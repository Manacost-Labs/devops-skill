{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Signed protected execution scope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "audience", "registry_digest", "not_before", "expires", "subject", "epoch", "mode", "task_ids", "max_operations", "trusted_environment", "signatures"],
  "properties": {
    "schema_version": {"const": "1.0"}, "kind": {"const": "grant"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{5,79}$"},
    "audience": {"type": "string", "pattern": "^[a-z][a-z0-9-]{5,79}$"},
    "registry_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "subject": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "epoch": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "not_before": {"type": "string", "format": "date-time"},
    "expires": {"type": "string", "format": "date-time"},
    "mode": {"enum": ["safe", "balanced", "semi-auto", "full-auto"]},
    "max_operations": {"type": "integer", "minimum": 1, "maximum": 1024},
    "task_ids": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{5,79}$"}},
    "trusted_environment": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["isolation_ref", "credential_scope_ref", "owner_evidence_ref"], "properties": {"isolation_ref": {"type": "string"}, "credential_scope_ref": {"type": "string"}, "owner_evidence_ref": {"type": "string"}}}]},
    "signatures": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "object", "additionalProperties": false, "required": ["key_id", "signature"], "properties": {"key_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{5,79}$"}, "signature": {"type": "string", "minLength": 88, "maxLength": 88}}}}
  }
}
